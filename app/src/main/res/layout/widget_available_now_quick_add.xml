<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:contentDescription="@string/widget_quick_add_tap_hint"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingEnd="14dp"
    android:paddingStart="14dp"
    android:paddingTop="10dp">

    <TextView
        android:id="@+id/widget_quick_add_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/home_available_now"
        android:textColor="@color/widget_supporting"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_quick_add_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/widget_empty_value"
        android:textColor="@color/widget_foreground"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>
